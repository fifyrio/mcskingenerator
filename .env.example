# ===========================================================================
# mcskingenerator — environment variable template
# Copy to .env.local and fill in. Never commit real values.
# ===========================================================================

NODE_ENV=development

# --- Supabase (REQUIRED) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# TODO: Dashboard > Project Settings > API Keys > service_role (secret). Server-only, never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth / app (REQUIRED) -------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=7d
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Google One Tap login (optional) ---------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- KIE image / video generation (required for the generator) -------------
KIE_API_TOKEN=
KIE_API_URL=https://api.kie.ai
KIE_CALLBACK_URL=http://localhost:3001/api/webhooks/kie-callback
KIE_VIDEO_CALLBACK_URL=http://localhost:3001/api/webhooks/kie-video-callback

# --- Cloudflare R2 storage (required for saving generated images) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
NEXT_PUBLIC_R2_ENDPOINT=

# --- Cloudflare KV cache (optional) ----------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_API_TOKEN=
CLOUDFLARE_KV_NAMESPACE_ID=

# --- Waffo Pancake payments (optional until you sell) ----------------------
PAYMENT_ENV=test
WAFFO_TEST_MERCHANT_ID=
WAFFO_TEST_STORE_ID=
WAFFO_TEST_PRIVATE_KEY_BASE64=
WAFFO_TEST_BASIC_PRODUCT_ID=
WAFFO_TEST_PRO_PRODUCT_ID=
WAFFO_TEST_MAX_PRODUCT_ID=
# WAFFO_PROD_MERCHANT_ID=
# WAFFO_PROD_STORE_ID=
# WAFFO_PROD_PRIVATE_KEY_BASE64=
# WAFFO_PROD_BASIC_PRODUCT_ID=
# WAFFO_PROD_PRO_PRODUCT_ID=
# WAFFO_PROD_MAX_PRODUCT_ID=

# --- Credits tuning (optional, defaults shown) -----------------------------
CREDITS_DEFAULT=10
CREDITS_PROMPT_ENHANCEMENT=2
CREDITS_IMAGE_GENERATION=5
CREDITS_BACKGROUND_REMOVAL_ORIGINAL=1

# --- Rate limiting / misc (optional) ---------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
MODERATION_ENABLED=false

# --- Analytics (optional) --------------------------------------------------
NEXT_PUBLIC_GA_TRACKING_ID=
